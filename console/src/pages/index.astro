	// Canvas Charts
	function renderSimpleLineChart(canvasId: string, dataPoints: number[], color: string) {
		const canvas = document.getElementById(canvasId) as HTMLCanvasElement;
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const w = canvas.width = canvas.parentElement?.clientWidth || 500;
		const h = canvas.height = 200;
		ctx.clearRect(0, 0, w, h);

		ctx.strokeStyle = '#f1f5f9';
		ctx.lineWidth = 1;
		for (let y = 20; y < h; y += 40) {
			ctx.beginPath();
			ctx.moveTo(30, y);
			ctx.lineTo(w, y);
			ctx.stroke();
		}

		const max = Math.max(...dataPoints, 10) * 1.2;
		const stepX = (w - 40) / Math.max(1, dataPoints.length - 1);

		const grad = ctx.createLinearGradient(0, 0, 0, h);
		grad.addColorStop(0, `${color}33`);
		grad.addColorStop(1, `${color}00`);

		ctx.beginPath();
		dataPoints.forEach((val, i) => {
			const x = 30 + i * stepX;
			const y = h - 20 - (val / max) * (h - 40);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.lineTo(w - 10, h - 20);
		ctx.lineTo(30, h - 20);
		ctx.fillStyle = grad;
		ctx.fill();

		ctx.beginPath();
		ctx.strokeStyle = color;
		ctx.lineWidth = 2.5;
		dataPoints.forEach((val, i) => {
			const x = 30 + i * stepX;
			const y = h - 20 - (val / max) * (h - 40);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.stroke();
	}

	// Benchmark Live Lab Engine
	const labTerminal = document.getElementById('lab-terminal');
	const btnLabStart = document.getElementById('btn-lab-start') as HTMLButtonElement;
	const btnLabStop = document.getElementById('btn-lab-stop') as HTMLButtonElement;
	let labChartData: { time: number; msgRate: number; reqRate: number; latency: number }[] = [];
	let labEventSource: EventSource | null = null;

	function appendLabTerminal(msg: string, type = 'log') {
		if (!labTerminal) return;
		const line = document.createElement('div');
		line.className = `terminal-line ${type}-line`;
		line.innerText = msg;
		labTerminal.appendChild(line);
		labTerminal.scrollTop = labTerminal.scrollHeight;
	}

	document.getElementById('btn-clear-lab-terminal')?.addEventListener('click', () => {
		if (labTerminal) labTerminal.innerHTML = '';
	});

	function drawLabChart() {
		const canvas = document.getElementById('lab-chart') as HTMLCanvasElement;
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const w = canvas.width = canvas.parentElement?.clientWidth || 500;
		const h = canvas.height = 240;
		ctx.clearRect(0, 0, w, h);

		ctx.strokeStyle = '#1e293b';
		ctx.lineWidth = 1;
		for (let y = 30; y < h - 20; y += 40) {
			ctx.beginPath();
			ctx.moveTo(40, y);
			ctx.lineTo(w - 10, y);
			ctx.stroke();
		}

		if (labChartData.length < 2) return;

		const maxMsg = Math.max(1000, ...labChartData.map(d => d.msgRate)) * 1.15;
		const maxLatency = Math.max(5, ...labChartData.map(d => d.p99 || d.latency || 5)) * 1.25;
		const stepX = (w - 60) / (labChartData.length - 1);

		// Messages/sec Line (Green)
		ctx.strokeStyle = '#10b981';
		ctx.lineWidth = 2.5;
		ctx.beginPath();
		labChartData.forEach((d, i) => {
			const x = 50 + i * stepX;
			const y = h - 30 - (d.msgRate / maxMsg) * (h - 60);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.stroke();

		// Requests/sec Line (Blue)
		ctx.strokeStyle = '#3b82f6';
		ctx.lineWidth = 2;
		ctx.beginPath();
		labChartData.forEach((d, i) => {
			const x = 50 + i * stepX;
			const y = h - 30 - (d.reqRate / maxMsg) * (h - 60);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.stroke();

		// P50 Latency (Amber solid)
		ctx.strokeStyle = '#f59e0b';
		ctx.lineWidth = 1.8;
		ctx.beginPath();
		labChartData.forEach((d, i) => {
			const x = 50 + i * stepX;
			const y = h - 30 - ((d.p50 || d.latency) / maxLatency) * (h - 60);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.stroke();

		// P95 Latency (Purple dashed)
		ctx.setLineDash([4, 3]);
		ctx.strokeStyle = '#8b5cf6';
		ctx.lineWidth = 1.8;
		ctx.beginPath();
		labChartData.forEach((d, i) => {
			const x = 50 + i * stepX;
			const y = h - 30 - ((d.p95 || (d.latency * 1.5)) / maxLatency) * (h - 60);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.stroke();

		// P99 Latency Spike Boundary (Red dotted)
		ctx.setLineDash([2, 2]);
		ctx.strokeStyle = '#ef4444';
		ctx.lineWidth = 2;
		ctx.beginPath();
		labChartData.forEach((d, i) => {
			const x = 50 + i * stepX;
			const y = h - 30 - ((d.p99 || (d.latency * 2.2)) / maxLatency) * (h - 60);
			if (i === 0) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		});
		ctx.stroke();
		ctx.setLineDash([]);
	}

	document.getElementById('lab-benchmark-form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const url = (document.getElementById('lab-url') as HTMLInputElement).value;
		const mode = (document.getElementById('lab-mode') as HTMLSelectElement).value;
		const concurrency = parseInt((document.getElementById('lab-concurrency') as HTMLInputElement).value);
		const durationSeconds = parseInt((document.getElementById('lab-duration') as HTMLInputElement).value);
		const batchSize = parseInt((document.getElementById('lab-batch-size') as HTMLInputElement).value);

		labChartData = [];
		drawLabChart();
		if (btnLabStart) btnLabStart.disabled = true;
		if (btnLabStop) btnLabStop.disabled = false;

		appendLabTerminal(`[INIT] Launching Ma7-MQ Benchmark against ${url}...`, 'system');

		if (labEventSource) labEventSource.close();
		labEventSource = new EventSource(`${API_BASE}/api/benchmark/stream`);
		labEventSource.onmessage = (evt) => {
			try {
				const d = JSON.parse(evt.data);
				if (d.type === 'log') {
					appendLabTerminal(d.text);
				} else if (d.type === 'metric') {
					const m = d.data;
					labChartData.push({
						time: m.elapsed,
						msgRate: m.messagesPerSec || 0,
						reqRate: m.requestsPerSec || 0,
						latency: m.avgLatencyMs || 0,
						p50: m.p50Ms || 0,
						p95: m.p95Ms || 0,
						p99: m.p99Ms || 0,
						maxLat: m.maxLatencyMs || 0
					});
					if (labChartData.length > 40) labChartData.shift();
					drawLabChart();

					// Live update KPI cards in real time
					const tp = document.getElementById('lab-throughput-val');
					if (tp) tp.innerText = (m.messagesPerSec || 0).toLocaleString();
					const p50 = document.getElementById('lab-p50-val');
					if (p50) p50.innerText = (m.p50Ms || 0).toFixed(1);
					const p95 = document.getElementById('lab-p95-val');
					if (p95) p95.innerText = (m.p95Ms || 0).toFixed(1);
					const p99 = document.getElementById('lab-p99-val');
					if (p99) p99.innerText = (m.p99Ms || 0).toFixed(1);
					const maxL = document.getElementById('lab-max-val');
					if (maxL) maxL.innerText = (m.maxLatencyMs || 0).toFixed(1);

				} else if (d.type === 'done') {
					const finalD = d.data;
					appendLabTerminal('[SUCCESS] Benchmark run completed.', 'system');
					if (btnLabStart) btnLabStart.disabled = false;
					if (btnLabStop) btnLabStop.disabled = true;

					if (finalD) {
						const tp = document.getElementById('lab-throughput-val');
						if (tp) tp.innerText = (finalD.messagesPerSec || 0).toLocaleString();
						const p50 = document.getElementById('lab-p50-val');
						if (p50) p50.innerText = (finalD.p50Ms || 0).toFixed(1);
						const p95 = document.getElementById('lab-p95-val');
						if (p95) p95.innerText = (finalD.p95Ms || 0).toFixed(1);
						const p99 = document.getElementById('lab-p99-val');
						if (p99) p99.innerText = (finalD.p99Ms || 0).toFixed(1);
						const maxL = document.getElementById('lab-max-val');
						if (maxL) maxL.innerText = (finalD.maxLatencyMs || 0).toFixed(1);
					}

					showToast('Benchmark run completed with full percentile telemetry!', 'success');
					fetchLiveQueues();
				}
			} catch (err) {}
		};

		const res = await fetch(`${API_BASE}/api/benchmark/start`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				url,
				concurrency,
				durationSeconds,
				batchSize,
				useBatch: mode === 'batch'
			})
		});

		if (!res.ok) {
			appendLabTerminal('[ERROR] Failed to connect to benchmark runner.', 'error');
			if (btnLabStart) btnLabStart.disabled = false;
			if (btnLabStop) btnLabStop.disabled = true;
		}
	});

	document.getElementById('btn-lab-stop')?.addEventListener('click', async () => {
		await fetch(`${API_BASE}/api/benchmark/stop`, { method: 'POST' });
		appendLabTerminal('[WARN] Benchmark stopped.', 'system');
		if (btnLabStart) btnLabStart.disabled = false;
		if (btnLabStop) btnLabStop.disabled = true;
	});

	// Global telemetry streaming
	const telemetrySource = new EventSource(`${API_BASE}/api/stream/metrics`);
	telemetrySource.onmessage = (e) => {
		try {
			const data = JSON.parse(e.data);

			// KPIs
			const tp = document.getElementById('stat-message-rate');
			if (tp) tp.innerText = (data.throughput || 0).toLocaleString();

			const tm = document.getElementById('stat-total-messages');
			if (tm) tm.innerText = (data.totalMessages || 0).toLocaleString();

			const qc = document.getElementById('stat-queues-count');
			if (qc && data.topics !== undefined) qc.innerText = data.topics.toString();

			const cc = document.getElementById('stat-consumers-count');
			if (cc && data.consumers !== undefined) cc.innerText = data.consumers.toString();

			// Health meters
			if (data.cpu !== undefined) {
				const cv = document.getElementById('health-cpu-val');
				const cb = document.getElementById('health-cpu-bar');
				if (cv) cv.innerText = `${data.cpu}%`;
				if (cb) cb.style.width = `${data.cpu}%`;
			}
			if (data.memoryMB !== undefined) {
				const mv = document.getElementById('health-mem-val');
				const mb = document.getElementById('health-mem-bar');
				if (mv) mv.innerText = `${data.memoryMB} MB`;
				if (mb) mb.style.width = `${Math.min(100, Math.max(10, data.memoryMB / 2))}%`;
			}
			if (data.uptime) {
				const ub = document.getElementById('sidebar-uptime');
				if (ub) ub.innerText = `Uptime: ${data.uptime}`;
			}

			// Activities table
			if (data.activities && data.activities.length > 0) {
				const tbody = document.getElementById('overview-activity-tbody');
				if (tbody) {
					tbody.innerHTML = data.activities.map((a: any) => `
						<tr>
							<td class="mono">${a.time}</td>
							<td>${a.event}</td>
							<td><span class="tag">${a.type}</span></td>
							<td><code>${a.resource}</code></td>
							<td><span class="badge ${a.status === 'Deleted' ? 'badge-warn' : 'badge-success'}">${a.status}</span></td>
						</tr>
					`).join('');
				}
			}

			// Push to rolling charts
			queuedHistory.push(data.totalMessages || 0);
			if (queuedHistory.length > 15) queuedHistory.shift();
			renderSimpleLineChart('chart-queued-messages', queuedHistory, '#f5b800');

			throughputHistory.push(data.throughput || 0);
			if (throughputHistory.length > 15) throughputHistory.shift();
			renderSimpleLineChart('chart-message-rates', throughputHistory, '#10b981');
			renderSimpleLineChart('chart-monitoring-deep', throughputHistory, '#3b82f6');

		} catch (err) {}
	};

	// Initial data loads
	fetchLiveQueues();
	fetchLiveExchanges();
	renderConnectionsTable();
	fetchLiveChannels();
	fetchLiveConsumers();
	fetchLiveNodes();
	fetchLiveLogs();

	renderSimpleLineChart('chart-queued-messages', queuedHistory, '#f5b800');
	renderSimpleLineChart('chart-message-rates', throughputHistory, '#10b981');
	renderSimpleLineChart('chart-monitoring-deep', throughputHistory, '#3b82f6');
</script>

